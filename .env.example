# Copy to .env.local and fill in. Never commit real values.

# Database (Neon free tier connection string)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# OAuth (optional to start)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Price extraction
# Link-preview fallback (prototype used microlink's free endpoint)
MICROLINK_BASE="https://api.microlink.io"
# Optional affiliate networks (add as you integrate)
AWIN_API_TOKEN=""
SKIMLINKS_ID=""

# Email / notifications (Resend free tier)
# AUTH_RESEND_KEY is used for magic-link sign-in emails (falls back to RESEND_API_KEY)
AUTH_RESEND_KEY=""
RESEND_API_KEY=""
# Until a domain is verified in Resend, use their shared sender: "Baskit <onboarding@resend.dev>"
# After verifying suhmantics.com in Resend: "Baskit <baskit@suhmantics.com>"
EMAIL_FROM="Baskit <onboarding@resend.dev>"
# The branded sender is send-only — replies route here instead of bouncing
EMAIL_REPLY_TO="suhmantics@gmail.com"

# Cron auth — shared secret the scheduler sends to protect /api/cron/*
CRON_SECRET="generate-a-random-string"

# Web push (optional, phase 2)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
