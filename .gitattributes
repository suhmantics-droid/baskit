# Normalise line endings so diffs stay clean across Windows/macOS/Linux clones.
# Text files are stored with LF in the repo; git converts on checkout as needed.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
